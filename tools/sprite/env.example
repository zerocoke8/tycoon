# tools/sprite/.env.local 로 복사해 채운다 (.env.local은 .gitignore의 '.env.*'로 저장소에 들어가지 않는다).
# 환경 변수가 있으면 환경 변수가 이긴다.

# BytePlus ModelArk 콘솔 → API Key
SEEDANCE_API_KEY=

# BytePlus (해외, 기본값)
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# 火山方舟 Ark (중국 계정이면 위 둘 대신)
# SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL=doubao-seedance-2-5-260628

# ffmpeg를 못 찾으면 (파일 또는 bin 폴더)
# FFMPEG=C:\Users\me\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.2-full_build\bin
